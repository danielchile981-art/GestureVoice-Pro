#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")"
VERSION=8.11.1
BASE=".gradle/bootstrap/gradle-$VERSION"
if [ ! -x "$BASE/bin/gradle" ]; then
  if command -v gradle >/dev/null 2>&1; then exec gradle "$@"; fi
  mkdir -p .gradle/bootstrap
  echo "Baixando Gradle $VERSION pelo site oficial..." >&2
  curl --fail --location --retry 2 --connect-timeout 15 --max-time 30 --output ".gradle/bootstrap/gradle.zip" "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"
  unzip -q ".gradle/bootstrap/gradle.zip" -d .gradle/bootstrap
  rm ".gradle/bootstrap/gradle.zip"
fi
exec "$BASE/bin/gradle" "$@"
